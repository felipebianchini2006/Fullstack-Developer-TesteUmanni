<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
  <div class="container-fluid">
    <%= link_to "Umanni", root_path, class: "navbar-brand" %>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <% if user_signed_in? %>
        <ul class="navbar-nav ms-auto">
          <% if current_user.admin? %>
            <li class="nav-item">
              <%= link_to "Dashboard", admin_dashboard_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Users", admin_users_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Import Users", import_admin_users_path, class: "nav-link" %>
            </li>
          <% end %>

          <li class="nav-item">
            <%= link_to "My Profile", profile_path, class: "nav-link" %>
          </li>

          <li class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle d-flex align-items-center"
              href="#"
              id="userDropdown"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <% if current_user.avatar_image.attached? %>
                <%= image_tag current_user.avatar_image, alt: current_user.full_name, class: "avatar-sm me-2" %>
              <% else %>
                <span class="badge bg-secondary me-2">
                  <%= current_user.full_name.split.map(&:first).join %>
                </span>
              <% end %>
              <%= current_user.full_name %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
              <li>
                <span class="dropdown-item-text text-muted small">
                  <%= current_user.email %>
                </span>
              </li>
              <li>
                <span class="dropdown-item-text small">
                  <%= current_user.admin? ? "Admin User" : "Regular User" %>
                </span>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= link_to "Edit Profile", edit_profile_path, class: "dropdown-item" %>
              </li>
              <li>
                <%= link_to "Delete Account", profile_path, method: :delete, data: { confirm: "Are you sure? This cannot be undone." }, class: "dropdown-item text-danger" %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "dropdown-item" %>
              </li>
            </ul>
          </li>
        </ul>
      <% else %>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <%= link_to "Sign In", new_user_session_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Sign Up", new_user_registration_path, class: "nav-link" %>
          </li>
        </ul>
      <% end %>
    </div>
  </div>
</nav>
