<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Umanni User Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Umanni User Management">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Bootstrap 5 CSS from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUarbnLpmA+a5visy7h7KqGUGH8RmNE21EH5nwAbBiY9mJ7Bzy7" crossorigin="anonymous">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      :root {
        --primary-color: #007bff;
        --secondary-color: #6c757d;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --warning-color: #ffc107;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-color: #f8f9fa;
      }

      main {
        flex: 1;
      }

      .navbar-brand {
        font-weight: 700;
        font-size: 1.5rem;
      }

      .avatar-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
      }

      .avatar-md {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #e9ecef;
      }

      .avatar-preview {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #dee2e6;
        margin: 15px 0;
      }

      .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
      }

      .stat-card {
        padding: 2rem;
        text-align: center;
        border-left: 4px solid var(--primary-color);
      }

      .stat-card h3 {
        font-size: 2rem;
        font-weight: 700;
        margin: 10px 0;
      }

      .stat-card p {
        color: #6c757d;
        margin: 0;
      }

      .badge-role {
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
        font-weight: 600;
      }

      .table-hover tbody tr:hover {
        background-color: #f5f5f5;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
      }

      .btn-group-sm > .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
      }

      .fade-in {
        animation: fadeIn 0.3s ease-in;
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      .real-time-badge {
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
      }

      .action-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      @media (max-width: 768px) {
        .action-buttons {
          flex-direction: column;
        }

        .action-buttons .btn {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <%= render "shared/navbar" %>

    <main class="flex-grow-1">
      <%= render "shared/flash_messages" %>
      <%= yield %>
    </main>

    <!-- Bootstrap 5 JS Bundle from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWbSxccPQtF3EpF3fnJHog6LaEVF6d1uWvsTogUv6C9w7s28T" crossorigin="anonymous"></script>

    <!-- Action Cable Consumer -->
    <script type="module">
      import * as ActionCable from "@rails/actioncable"

      window.Cable = ActionCable.createConsumer()
    </script>

    <script>
      // Dismiss alerts after 5 seconds
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.alert:not(.alert-persistent)').forEach(function(alert) {
          setTimeout(function() {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }, 5000);
        });
      });

      // Confirm before delete actions
      document.addEventListener('turbo:before-fetch-request', function(event) {
        const form = event.detail.fetchOptions.body;
        if (form && form instanceof FormData && form.get('_method') === 'delete') {
          if (!confirm('Are you sure you want to delete this item? This action cannot be undone.')) {
            event.preventDefault();
          }
        }
      });
    </script>
  </body>
</html>
