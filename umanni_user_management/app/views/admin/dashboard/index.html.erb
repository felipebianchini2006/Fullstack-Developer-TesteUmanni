<% content_for(:title, "Admin Dashboard - Umanni User Management") %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="display-6 fw-bold mb-2">Admin Dashboard</h1>
      <p class="text-muted">Welcome back, <%= current_user.full_name %>!</p>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row mb-4">
    <div class="col-md-4 mb-3">
      <div class="card stat-card">
        <h5 class="text-muted text-uppercase">Total Users</h5>
        <h3 class="text-primary real-time" data-stat="total_users">
          <%= @total_users %>
        </h3>
        <p class="mb-0">
          <%= link_to "View All", admin_users_path, class: "text-decoration-none small" %>
        </p>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card stat-card">
        <h5 class="text-muted text-uppercase">Admin Users</h5>
        <h3 class="text-danger real-time" data-stat="total_admins">
          <%= @total_admins %>
        </h3>
        <p class="text-muted small mb-0">
          <%= percentage_of(@total_admins, @total_users) %>% of total
        </p>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card stat-card">
        <h5 class="text-muted text-uppercase">Regular Users</h5>
        <h3 class="text-success real-time" data-stat="total_regular_users">
          <%= @total_regular_users %>
        </h3>
        <p class="text-muted small mb-0">
          <%= percentage_of(@total_regular_users, @total_users) %>% of total
        </p>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-lg-6 mb-4 mb-lg-0">
      <div class="card">
        <div class="card-header bg-light border-bottom">
          <h5 class="mb-0 fw-bold">Recent Users</h5>
        </div>
        <div class="card-body p-0">
          <% if @recent_users.any? %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Joined</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_users.each do |user| %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center">
                          <% if user.avatar_image.attached? %>
                            <%= image_tag user.avatar_image, alt: user.full_name, class: "avatar-sm me-2" %>
                          <% else %>
                            <span class="badge bg-secondary me-2">
                              <%= user.full_name.split.map(&:first).join %>
                            </span>
                          <% end %>
                          <strong><%= user.full_name %></strong>
                        </div>
                      </td>
                      <td>
                        <span class="text-muted small"><%= user.email %></span>
                      </td>
                      <td>
                        <% if user.admin? %>
                          <span class="badge bg-danger badge-role">Admin</span>
                        <% else %>
                          <span class="badge bg-secondary badge-role">User</span>
                        <% end %>
                      </td>
                      <td>
                        <span class="text-muted small">
                          <%= time_ago_in_words(user.created_at) %> ago
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="alert alert-info mb-0 m-3">
              <strong>No users yet.</strong> Start creating users or importing them from a file.
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card">
        <div class="card-header bg-light border-bottom">
          <h5 class="mb-0 fw-bold">Recent Imports</h5>
        </div>
        <div class="card-body p-0">
          <% if @recent_imports.any? %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>File</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_imports.each do |import_job| %>
                    <tr>
                      <td>
                        <span class="fw-bold"><%= import_job.file_name %></span>
                        <br>
                        <span class="text-muted small">By <%= import_job.user.full_name %></span>
                      </td>
                      <td>
                        <% case import_job.status %>
                          <% when 'pending' %>
                            <span class="badge bg-warning badge-role">Pending</span>
                          <% when 'processing' %>
                            <span class="badge bg-info badge-role real-time-badge">Processing</span>
                          <% when 'completed' %>
                            <span class="badge bg-success badge-role">Completed</span>
                          <% when 'failed' %>
                            <span class="badge bg-danger badge-role">Failed</span>
                        <% end %>
                      </td>
                      <td>
                        <% if import_job.processing? || import_job.pending? %>
                          <div class="progress" style="height: 20px;">
                            <div
                              class="progress-bar progress-bar-striped progress-bar-animated"
                              role="progressbar"
                              style="width: <%= import_job.progress_percentage %>%"
                              aria-valuenow="<%= import_job.progress_percentage %>"
                              aria-valuemin="0"
                              aria-valuemax="100"
                            >
                              <span class="small fw-bold text-white">
                                <%= number_with_precision(import_job.progress_percentage, precision: 1) %>%
                              </span>
                            </div>
                          </div>
                        <% else %>
                          <small class="text-muted">
                            <%= "#{import_job.processed_records}/#{import_job.total_records}" %>
                          </small>
                        <% end %>
                      </td>
                      <td>
                        <span class="text-muted small">
                          <%= time_ago_in_words(import_job.created_at) %> ago
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="alert alert-info mb-0 m-3">
              <strong>No imports yet.</strong> Start by <%= link_to "importing users", import_admin_users_path %>.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-light border-bottom">
          <h5 class="mb-0 fw-bold">Quick Actions</h5>
        </div>
        <div class="card-body">
          <div class="d-flex flex-wrap gap-2">
            <%= link_to "Create New User", new_admin_user_path, class: "btn btn-primary" %>
            <%= link_to "Import Users", import_admin_users_path, class: "btn btn-outline-primary" %>
            <%= link_to "Manage Users", admin_users_path, class: "btn btn-outline-secondary" %>
            <%= link_to "Edit Profile", edit_profile_path, class: "btn btn-outline-info" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Real-time updates with Action Cable -->
<script type="module">
  document.addEventListener('DOMContentLoaded', function() {
    if (window.Cable) {
      const subscription = window.Cable.subscriptions.create("DashboardChannel", {
        connected() {
          console.log("Connected to dashboard updates");
        },

        received(data) {
          console.log("Received data:", data);

          // Update statistics
          if (data.total_users !== undefined) {
            document.querySelector('[data-stat="total_users"]').textContent = data.total_users;
          }
          if (data.total_admins !== undefined) {
            document.querySelector('[data-stat="total_admins"]').textContent = data.total_admins;
          }
          if (data.total_regular_users !== undefined) {
            document.querySelector('[data-stat="total_regular_users"]').textContent = data.total_regular_users;
          }

          // Show notification
          const eventType = data.event || 'update';
          const message = eventType.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
          console.log("Dashboard updated:", message);
        }
      });
    }
  });
</script>