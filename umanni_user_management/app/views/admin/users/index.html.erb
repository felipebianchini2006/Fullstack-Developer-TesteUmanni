<% content_for(:title, "Users - Admin Dashboard") %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h1 class="display-6 fw-bold mb-2">User Management</h1>
          <p class="text-muted">
            Total users: <strong><%= User.count %></strong>
          </p>
        </div>
        <div class="action-buttons">
          <%= link_to "New User", new_admin_user_path, class: "btn btn-primary" %>
          <%= link_to "Import Users", import_admin_users_path, class: "btn btn-outline-primary" %>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <% if @users.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Joined</th>
                <th class="text-center pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @users.each do |user| %>
                <tr data-user-id="<%= user.id %>">
                  <td class="ps-4">
                    <div class="d-flex align-items-center">
                      <% if user.avatar_image.attached? %>
                        <%= link_to image_tag(user.avatar_image, alt: user.full_name, class: "avatar-sm me-3"), admin_user_path(user) %>
                      <% else %>
                        <span class="badge bg-secondary me-3" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                          <%= user.full_name.split.map(&:first).join %>
                        </span>
                      <% end %>
                      <%= link_to user.full_name, admin_user_path(user), class: "text-decoration-none fw-bold" %>
                    </div>
                  </td>
                  <td>
                    <span class="text-muted"><%= user.email %></span>
                  </td>
                  <td>
                    <% if user.admin? %>
                      <span class="badge bg-danger badge-role">Admin</span>
                    <% else %>
                      <span class="badge bg-secondary badge-role">User</span>
                    <% end %>
                  </td>
                  <td>
                    <span class="text-muted small">
                      <%= time_ago_in_words(user.created_at) %> ago
                    </span>
                  </td>
                  <td class="pe-4">
                    <div class="btn-group btn-group-sm" role="group">
                      <%= link_to "View", admin_user_path(user), class: "btn btn-outline-info btn-sm", title: "View user" %>
                      <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-outline-primary btn-sm", title: "Edit user" %>

                      <% if current_user.admin? && current_user != user %>
                        <%= button_to "Toggle Role", toggle_role_admin_user_path(user), method: :patch, class: "btn btn-outline-warning btn-sm", title: "Toggle user role", data: { disable_with: "..." } %>
                      <% end %>

                      <% if current_user.admin? && current_user != user %>
                        <%= button_to "Delete", admin_user_path(user), method: :delete, class: "btn btn-outline-danger btn-sm", title: "Delete user", data: { confirm: "Are you sure? This cannot be undone.", disable_with: "..." } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if @pagy %>
          <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
            <small class="text-muted">
              Showing <%= (@pagy.page - 1) * @pagy.items + 1 %> to <%= [@pagy.page * @pagy.items, @pagy.count].min %> of <%= @pagy.count %> users
            </small>
            <nav aria-label="Pagination">
              <ul class="pagination mb-0">
                <% if @pagy.prev %>
                  <li class="page-item">
                    <%= link_to "Previous", url_for(page: @pagy.prev), class: "page-link" %>
                  </li>
                <% else %>
                  <li class="page-item disabled">
                    <span class="page-link">Previous</span>
                  </li>
                <% end %>

                <% @pagy.series.each do |page_item| %>
                  <% if page_item.is_a?(Integer) %>
                    <% if page_item == @pagy.page %>
                      <li class="page-item active">
                        <span class="page-link">
                          <%= page_item %>
                          <span class="visually-hidden">(current)</span>
                        </span>
                      </li>
                    <% else %>
                      <li class="page-item">
                        <%= link_to page_item, url_for(page: page_item), class: "page-link" %>
                      </li>
                    <% end %>
                  <% elsif page_item == :gap %>
                    <li class="page-item disabled">
                      <span class="page-link">...</span>
                    </li>
                  <% end %>
                <% end %>

                <% if @pagy.next %>
                  <li class="page-item">
                    <%= link_to "Next", url_for(page: @pagy.next), class: "page-link" %>
                  </li>
                <% else %>
                  <li class="page-item disabled">
                    <span class="page-link">Next</span>
                  </li>
                <% end %>
              </ul>
            </nav>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info m-3 mb-0">
          <strong>No users found.</strong> Start by
          <%= link_to "creating a new user", new_admin_user_path, class: "alert-link" %>
          or
          <%= link_to "importing from a file", import_admin_users_path, class: "alert-link" %>.
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-4">
    <%= link_to "Back to Dashboard", admin_dashboard_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<style>
  .btn-group-sm {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .btn-group-sm .btn {
    flex: 1;
    min-width: auto;
  }

  @media (max-width: 768px) {
    .btn-group-sm {
      flex-direction: column;
    }

    .btn-group-sm .btn {
      width: 100%;
    }
  }
</style>
