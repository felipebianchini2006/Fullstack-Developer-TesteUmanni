<% content_for(:title, "Create New User") %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-bold">Create New User</h1>
        <%= link_to "Back to Users", admin_users_path, class: "btn btn-outline-secondary" %>
      </div>

      <div class="card">
        <div class="card-body p-4">
          <div class="alert alert-info mb-4">
            <strong>Note:</strong> You are creating a new user account. All fields marked with <strong class="text-danger">*</strong> are required.
          </div>

          <%= render "form" %>
        </div>
      </div>

      <div class="mt-4">
        <div class="card border-left-primary">
          <div class="card-body">
            <h5 class="fw-bold mb-3">Tips for Creating Users</h5>
            <ul class="mb-0">
              <li>Choose strong passwords with a mix of uppercase, lowercase, numbers, and symbols</li>
              <li>Use the user's full name as it will appear in the system</li>
              <li>Email addresses must be unique and properly formatted</li>
              <li>Admins can access the dashboard and manage other users</li>
              <li>Regular users can only access their own profile</li>
              <li>You can add a profile picture during or after creation</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .border-left-primary {
    border-left: 4px solid #007bff;
  }
</style>
