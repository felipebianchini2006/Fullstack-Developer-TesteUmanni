<% content_for(:title, "Edit User - #{@user.full_name}") %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-bold">Edit User</h1>
        <div class="action-buttons">
          <%= link_to "View Profile", admin_user_path(@user), class: "btn btn-info" %>
          <%= link_to "Back to Users", admin_users_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header bg-light border-bottom">
          <h5 class="mb-0 fw-bold">
            <%= @user.full_name %>
            <br>
            <small class="text-muted"><%= @user.email %></small>
          </h5>
        </div>
        <div class="card-body p-4">
          <div class="alert alert-info mb-4">
            <strong>Note:</strong> Leave the password fields blank to keep the current password unchanged.
          </div>

          <%= render "form" %>
        </div>
      </div>

      <div class="card">
        <div class="card-header bg-light border-bottom">
          <h5 class="mb-0 fw-bold">Account Information</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <div>
                <strong class="text-muted small text-uppercase">User ID</strong>
                <p class="font-monospace mb-0"><%= @user.id %></p>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div>
                <strong class="text-muted small text-uppercase">Current Role</strong>
                <p class="mb-0">
                  <% if @user.admin? %>
                    <span class="badge bg-danger badge-lg">Administrator</span>
                  <% else %>
                    <span class="badge bg-secondary badge-lg">Regular User</span>
                  <% end %>
                </p>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <div>
                <strong class="text-muted small text-uppercase">Created</strong>
                <p class="text-muted small mb-0">
                  <%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                </p>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div>
                <strong class="text-muted small text-uppercase">Last Updated</strong>
                <p class="text-muted small mb-0">
                  <%= @user.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
                </p>
              </div>
            </div>
          </div>

          <hr>

          <div class="alert alert-warning mt-3">
            <strong>Danger Zone:</strong>
          </div>

          <% if current_user.admin? && current_user != @user %>
            <div class="d-grid gap-2 mt-3">
              <% if @user.admin? %>
                <%= button_to "Demote to Regular User", toggle_role_admin_user_path(@user), method: :patch, class: "btn btn-warning", data: { disable_with: "Processing..." } %>
              <% else %>
                <%= button_to "Promote to Admin", toggle_role_admin_user_path(@user), method: :patch, class: "btn btn-warning", data: { disable_with: "Processing..." } %>
              <% end %>

              <%= button_to "Delete This User", admin_user_path(@user), method: :delete, class: "btn btn-danger", data: { confirm: "Are you absolutely sure? This action cannot be undone.", disable_with: "Deleting..." } %>
            </div>
          <% else %>
            <p class="text-muted small mb-0">
              You cannot modify roles or delete this user account.
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .badge-lg {
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
  }
</style>
